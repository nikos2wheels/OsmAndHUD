+++								}
+++							}
+++
+++							if (points.size() > 1) {
+++								if (lineIdx < lines.size()) {
+++									net.osmand.core.jni.VectorLine vl = lines.get(lineIdx);
+++									vl.setPoints(points);
+++									vl.setIsHidden(false);
+++									vl.setLineWidth(thickness);
+++									vl.setFillColor(NativeUtilities.createFColorARGB(color));
+++								} else {
