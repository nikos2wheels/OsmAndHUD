diff --git a/OsmAnd/src/net/osmand/plus/views/mapwidgets/widgets/HudLaneGuidanceWidget.java b/OsmAnd/src/net/osmand/plus/views/mapwidgets/widgets/HudLaneGuidanceWidget.java
