@@ -0,0 +1,279 @@
+package net.osmand.plus.views.mapwidgets.widgets;
+
+import android.annotation.SuppressLint;
+import android.graphics.Color;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.core.content.ContextCompat;
+
+import net.osmand.plus.R;
+import net.osmand.plus.activities.MapActivity;
+import net.osmand.plus.routing.NextDirectionInfo;
+import net.osmand.plus.settings.backend.ApplicationMode;
+import net.osmand.plus.utils.OsmAndFormatter;
+import net.osmand.plus.utils.OsmAndFormatterParams;
+import net.osmand.plus.views.layers.base.OsmandMapLayer.DrawSettings;
+import net.osmand.plus.views.mapwidgets.LanesDrawable;
+import net.osmand.plus.views.mapwidgets.MapWidgetInfo;
+import net.osmand.plus.views.mapwidgets.TurnDrawable;
+import net.osmand.plus.views.mapwidgets.WidgetType;
+import net.osmand.plus.views.mapwidgets.WidgetsPanel;
+import net.osmand.router.TurnType;
+
+import java.util.Arrays;
+import java.util.List;
+
+public class HudLaneGuidanceWidget extends MapWidget {
+
+    private ImageView imageView;
+    private TextView distanceText;
+    private final LanesDrawable lanesDrawable;
+    private final HudTurnDrawable turnDrawable;
+    
+    private float initialTouchY;
+    private float initialY;
+    private boolean isDragging = false;
+
+    private final net.osmand.plus.routing.IRouteInformationListener routeListener = new net.osmand.plus.routing.IRouteInformationListener() {
+        @Override
+        public void newRouteIsCalculated(boolean newRoute, net.osmand.data.ValueHolder<Boolean> showToast) {}
+        @Override
+        public void routeWasCancelled() {
+            app.runInUIThread(() -> updateVisibility(false));
+        }
+        @Override
+        public void routeWasFinished() {
+            app.runInUIThread(() -> updateVisibility(false));
+        }
+        @Override
+        public void followingModeChanged(boolean following) {
+            if (!following) {
+                app.runInUIThread(() -> updateVisibility(false));
+            }
+        }
+    };
+
+    public HudLaneGuidanceWidget(@NonNull MapActivity mapActivity, @Nullable String customId, @Nullable WidgetsPanel panel) {
+        super(mapActivity, WidgetType.HUD_LANE_GUIDANCE, customId, panel);
+        lanesDrawable = new LanesDrawable(mapActivity, mapActivity.getMapView().getScaleCoefficient());
+        turnDrawable = new HudTurnDrawable(mapActivity, false);
+
+        routingHelper.addListener(routeListener);
+    }
+
+    @Override
+    protected int getLayoutId() {
+        return R.layout.hud_lane_guidance_widget;
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    @Override
+    protected void setupView(@NonNull View view) {
+        super.setupView(view);
+        imageView = view.findViewById(R.id.hud_guidance_image);
+        distanceText = view.findViewById(R.id.hud_guidance_dist_text);
+
+        view.setOnTouchListener((v, event) -> {
+            switch (event.getAction()) {
+                case MotionEvent.ACTION_DOWN -> {
+                    initialTouchY = event.getRawY();
+                    initialY = v.getY();
+                    isDragging = false;
+                    return true;
+                }
+                case MotionEvent.ACTION_MOVE -> {
+                    float deltaY = event.getRawY() - initialTouchY;
+                    if (Math.abs(deltaY) > 10 || isDragging) {
+                        isDragging = true;
+                        float newY = initialY + deltaY;
+                        v.setY(newY);
+                        View parent = (View) v.getParent();
+                        if (parent != null) {
+                            float screenHeight = parent.getHeight();
+                            if (screenHeight > 0) {
+                                settings.HUD_LANE_GUIDANCE_Y.set(newY / screenHeight);
+                            }
+                        }
+                    }
+                    return true;
+                }
+                case MotionEvent.ACTION_UP -> {
+                    return isDragging;
+                }
+            }
+            return false;
+        });
+
+        Float savedY = settings.HUD_LANE_GUIDANCE_Y.get();
+        if (savedY != null && savedY >= 0) {
+            view.post(() -> {
+                View parent = (View) view.getParent();
+                if (parent != null) {
+                    float screenHeight = parent.getHeight();
+                    view.setY(savedY * screenHeight);
+                }
+            });
+        }
+    }
+
+    @Override
+    public void updateInfo(@NonNull View view, @Nullable DrawSettings drawSettings) {
+        TurnType turnType = null;
+        int distance = 0;
+        int imminent = -1;
+
+        boolean followingMode = routingHelper.isFollowingMode()
+                || app.getLocationProvider().getLocationSimulation().isRouteAnimating();
+        boolean calculated = routingHelper.isRouteCalculated();
+
+        if (followingMode && calculated && !routingHelper.isDeviatedFromRoute()) {
+            NextDirectionInfo directionInfo = routingHelper.getNextRouteDirectionInfo(new NextDirectionInfo(), false);
+            if (directionInfo != null && directionInfo.directionInfo != null) {
+                turnType = directionInfo.directionInfo.getTurnType();
+                distance = directionInfo.distanceTo;
+                imminent = directionInfo.imminent;
+            }
+        }
+
+        int[] lanes = turnType != null ? turnType.getLanes() : null;
+        boolean showLanes = lanes != null && lanes.length > 0;
+        boolean showTurn = !showLanes && turnType != null;
+
+        boolean visible = followingMode && calculated && (showLanes || showTurn);
+
+        if (visible) {
+            if (showLanes) {
+                updateLanes(lanes, imminent);
+                imageView.setImageDrawable(lanesDrawable);
+                distanceText.setVisibility(View.VISIBLE);
+                distanceText.setText(OsmAndFormatter.getFormattedDistance(distance, app, OsmAndFormatterParams.USE_LOWER_BOUNDS));
+            } else {
+                updateTurn(turnType, imminent);
+                imageView.setImageDrawable(turnDrawable);
+                distanceText.setVisibility(View.VISIBLE);
+                distanceText.setText(OsmAndFormatter.getFormattedDistance(distance, app, OsmAndFormatterParams.USE_LOWER_BOUNDS));
+            }
+        } else {
+            imageView.setImageDrawable(null);
+            distanceText.setVisibility(View.GONE);
+        }
+        imageView.invalidate();
+
+        updateVisibility(visible);
+    }
+
+    protected boolean shouldHide() {
+        return net.osmand.plus.routepreparationmenu.MapRouteInfoMenu.chooseRoutesVisible ||
+                net.osmand.plus.routepreparationmenu.MapRouteInfoMenu.followTrackVisible ||
+                visibilityHelper.shouldHideVerticalWidgets();
+    }
+
+    @Override
+    public boolean updateVisibility(boolean visible) {
+        boolean show = visible && !shouldHide();
+        boolean updatedVisibility = super.updateVisibility(show);
+
+        ViewGroup specialContainer = mapActivity.findViewById(R.id.hud_lane_guidance_container);
+        if (specialContainer != null) {
+            if (show) {
+                View v = getView();
+                if (v.getParent() != specialContainer) {
+                    if (v.getParent() != null) {
+                        ((ViewGroup) v.getParent()).removeView(v);
+                    }
+                    specialContainer.removeAllViews();
+                    specialContainer.addView(v);
+                }
+
+                Float savedY = settings.HUD_LANE_GUIDANCE_Y.get();
+                if (savedY != null && savedY >= 0) {
+                    v.post(() -> {
+                        if (v.getParent() == specialContainer) {
+                            float screenHeight = specialContainer.getHeight();
+                            if (screenHeight > 0) {
+                                v.setY(savedY * screenHeight);
+                            }
+                        }
+                    });
+                }
+            } else {
+                specialContainer.removeAllViews();
+            }
+        }
+
+        return updatedVisibility;
+    }
+
+    @Override
+    public void detachView(@NonNull WidgetsPanel widgetsPanel, @NonNull List<MapWidgetInfo> widgets, @NonNull ApplicationMode mode) {
+        ViewGroup specialContainer = mapActivity.findViewById(R.id.hud_lane_guidance_container);
+        if (specialContainer != null) {
+            specialContainer.removeView(getView());
+        }
+        routingHelper.removeListener(routeListener);
+        super.detachView(widgetsPanel, widgets, mode);
+    }
+
+    private void updateLanes(int[] lanes, int imminent) {
+        if (!Arrays.equals(lanesDrawable.lanes, lanes) || (imminent == 0) != lanesDrawable.imminent) {
+            lanesDrawable.lanes = lanes;
+            lanesDrawable.imminent = imminent == 0;
+            lanesDrawable.updateBounds();
+        }
+    }
+
+    private void updateTurn(TurnType turnType, int imminent) {
+        turnDrawable.updateColors(isNightMode());
+        if (turnDrawable.getTurnType() != turnType || turnDrawable.getTurnImminent() != imminent) {
+            turnDrawable.setTurnType(turnType);
+            turnDrawable.setTurnImminent(imminent, false);
+        }
+    }
+
+    @Override
+    public void attachView(@NonNull ViewGroup container, @NonNull WidgetsPanel panel, @NonNull List<MapWidget> followingWidgets) {
+        if (mapActivity.findViewById(R.id.hud_lane_guidance_container) == null) {
+            super.attachView(container, panel, followingWidgets);
+        }
+    }
+
+    private static class HudTurnDrawable extends TurnDrawable {
+        private final int size;
+
+        public HudTurnDrawable(MapActivity mapActivity, boolean mini) {
+            super(mapActivity, mini);
+            float density = mapActivity.getResources().getDisplayMetrics().density;
+            this.size = (int) (32 * density);
+            setBounds(0, 0, size, size);
+            updateHudColors();
+        }
+
+        @Override
+        public int getIntrinsicWidth() {
+            return size;
+        }
+
+        @Override
+        public int getIntrinsicHeight() {
+            return size;
+        }
+
+        private void updateHudColors() {
+            paintTurnOutlayStroke.setColor(ContextCompat.getColor(ctx, R.color.HUD_nav_arrow_stroke_color));
+            paintTurnOutlayFill.setColor(Color.TRANSPARENT);
+            paintRouteDirection.setColor(ContextCompat.getColor(ctx, R.color.HUD_nav_arrow));
+        }
+
+        @Override
+        public void setTurnImminent(int turnImminent, boolean deviatedFromRoute) {
+            super.setTurnImminent(turnImminent, deviatedFromRoute);
+            paintRouteDirection.setColor(ContextCompat.getColor(ctx, R.color.HUD_nav_arrow));
+        }
+    }
+}
