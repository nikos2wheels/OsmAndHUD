<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hud_guidance_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:background="#000000"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_horizontal"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/hud_guidance_main_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/hud_guidance_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:src="@drawable/widget_next_turn_day" />

        <TextView
            android:id="@+id/hud_guidance_exit_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/hud_exit_border"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:visibility="gone"
            tools:text="14"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/hud_guidance_dist_container_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="true"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/hud_guidance_dist_num_side"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                tools:text="100" />

            <TextView
                android:id="@+id/hud_guidance_dist_unit_side"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                tools:text="m" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hud_guidance_dist_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/hud_guidance_dist_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            tools:text="100" />

        <TextView
            android:id="@+id/hud_guidance_dist_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            tools:text="m" />
    </LinearLayout>

</LinearLayout>
